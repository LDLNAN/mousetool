# Mouse Tool: let the logged-in user open the hidraw nodes (for WebHID / mousetool)
# 00a5 = HyperSpeed dongle, 00a6 = USB cable
KERNEL=="hidraw*", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="00a5", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="00a6", MODE="0660", TAG+="uaccess"
# 00b3 = HyperPolling (8K) wireless dongle
KERNEL=="hidraw*", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="00b3", MODE="0660", TAG+="uaccess"
